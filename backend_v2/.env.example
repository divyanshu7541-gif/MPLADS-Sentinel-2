# backend_v2 local environment. Copy to backend_v2/.env for local (non-Docker) runs.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5433/sentinel
LOG_LEVEL=info

# ---- Google Gemma 4 via DigitalOcean Serverless Inference (optional) ----
# The AI Copilot and the chatbot's free-form layer are optional; without a
# key they degrade gracefully. Prefer the repository-root .env for these
# values (both files are read), or set them in the process environment.
# DO_INFERENCE_API_KEY=
# DO_GEMMA_MODEL=gemma-4-31B-it
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# DO_INFERENCE_TIMEOUT=30
