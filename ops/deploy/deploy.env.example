# Template for ops/deploy/deploy.env (git-ignored). All values here are SECRET
# unless marked public. Never commit the filled file.

# Secret. The run-44 database. Demo path: the local Docker Postgres on host port 5447.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@host.docker.internal:5447/sentinel
# Secret. >= 32 random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Public. Exact production origin(s), comma-separated, never "*".
CORS_ORIGINS=https://sentinel-mplads.vercel.app
# Public. The unchanged frontend sends no token, so the public site needs anonymous read.
ANONYMOUS_READ=true
# Secret. Attach the ROTATED key only after Deployment Protection / Access is on.
GEMINI_API_KEY=
