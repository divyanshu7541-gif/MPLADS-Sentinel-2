# MPLADS Sentinel — local environment configuration
#
# Copy this file to `.env` in the repository root (same level as this file)
# and fill in real values there. `.env` is already gitignored — never commit
# a real API key.
#
# Without any AI key the app still works: the Investigation Copilot is
# unavailable and the help chatbot falls back to its built-in, rule-based
# navigation guide. The deterministic risk engine never needs a key.

# ---- Google Gemma 4 via DigitalOcean Serverless Inference (primary) ----
# Create a model access key in the DigitalOcean control panel:
#   AI Platform -> Serverless Inference -> Model access keys
# Set it here or in the process environment. It is never sent to the browser.
DO_INFERENCE_API_KEY=

# Optional — model id. Defaults to Google Gemma 4 (31B instruction-tuned).
# DO_GEMMA_MODEL=gemma-4-31B-it

# Optional — OpenAI-compatible base URL. Include /v1: the OpenAI SDK appends
# "/chat/completions", producing https://inference.do-ai.run/v1/chat/completions.
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1

# Optional — per-request timeout in seconds (5–120, default 30).
# DO_INFERENCE_TIMEOUT=30

# ---- Optional Gemini fallback for the help chatbot ----
# The chatbot tries Gemma 4 first, then Gemini (if configured), then the
# built-in guide. Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — override the Gemini model. Defaults to Google's
# "gemini-flash-latest" alias (always the current recommended Flash model).
# GEMINI_MODEL=gemini-flash-latest
