# MPLADS Sentinel — local environment configuration
#
# Copy this file to `.env` in the repository root (same level as this file)
# and fill in real values there. `.env` is already gitignored — never commit
# a real API key.
#
# The in-app help chatbot works without any of this configured (it falls
# back to a built-in, rule-based navigation guide). Setting GEMINI_API_KEY
# below upgrades it to free-form AI answers via Google Gemini.

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — override the Gemini model used by the chatbot. Defaults to
# Google's "gemini-flash-latest" alias (always the current recommended
# Flash model), so most setups never need to touch this.
# GEMINI_MODEL=gemini-flash-latest
